# Centralized Neon PostgreSQL Database
DATABASE_URL=sqlite:///../../iotshield-local.db

# Authentication Secrets
AUTH_SECRET_KEY=replace-with-a-generated-secret
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_HOURS=8
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
