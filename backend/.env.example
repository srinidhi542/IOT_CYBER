# ===================================================
# IoT Sentinel Environment Configuration
# ===================================================

# LLM Configuration
# Provider options: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_ENABLED=true

# Provider API Keys (Set the one matching your selected LLM_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Local Configuration (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# NVD API Configuration (Optional: accelerates NVD 2.0 API rate limits)
NVD_API_KEY=

# RAG & Embeddings Configuration
# Embedding models: BAAI/bge-small-en-v1.5 | all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_DATA_DIR=backend/data/rag_cache
CHROMA_PERSIST_DIR=backend/data/chroma_db

# MongoDB Persistent Storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=iot_sentinel
